{"S05E02|868.0": {"d": 7.5, "caps": [[0.0, 0.63, "NO."], [0.66, 2.09, "BEH, DUE CONTRO UNO."], [2.12, 6.95, "AHI! AHI! AHI! AHI!"], [6.98, 7.5, "AHI! AHI! AHI!"]]}, "S01E12|1239.6": {"d": 13.5, "caps": [[0.0, 4.34, "AHI! IL MIO PIEDE! MALEDETTO, STUPIDO, GOFFO..."], [4.82, 7.31, "VEDETE? KRUSTY PORTAVA SCARPONI ENORMI,"], [7.34, 9.47, "MA HA I PIEDI PICCOLI, COME LE PERSONE DI BUON CUORE!"], [9.5, 13.22, "TELESPALLA BOB RIEMPIE LE SCARPE CON ENORMI PIEDONI BRUTTI!"]]}, "S05E02|1257.0": {"d": 6.5, "caps": [[0.0, 2.66, "FERMO LÌ, TELESPALLA BOB."], [2.98, 4.04, "SEI IN ARRESTO."], [4.22, 6.18, "PER LA BARBA DI LUCIFERO!"]]}, "S06E05|1054.0": {"d": 10.0, "caps": [[0.48, 2.73, "OH, MIO DIO: I MORTI SONO RISORTI"], [2.76, 4.1, "E VOTANO REPUBBLICANO."], [4.7, 6.29, "NO, NON CAPITE?"], [6.32, 7.56, "I MORTI NON POSSONO VOTARE."], [9.26, 10.0, "GUARDA..."]]}, "S06E05|1209.5": {"d": 14.5, "caps": [[0.0, 0.96, "VUOI ARRIVARE AL PUNTO?"], [1.1, 3.33, "SÌ. SOLO IO POTEVO ESEGUIRE"], [3.36, 6.52, "UN CAPOLAVORO DI FRODE ELETTORALE"], [6.68, 7.23, "E HO"], [7.26, 8.57, "I DOCUMENTI PER DIMOSTRARLO."], [8.6, 10.36, "QUI, GUARDATE QUESTI."], [10.72, 13.62, "OGNUNO UN'OPERA D'ARTE MACHIAVELLICA."]]}, "S08E16|957.0": {"d": 14.2, "caps": [[2.0, 5.26, "OH, È SENZA SPERANZA: TOTALMENTE SENZA SPERANZA."], [5.88, 6.78, "AH, CAPISCO."], [6.92, 9.51, "QUANDO È UNO DEI MIEI PIANI, NON FATE IN TEMPO A FERMARLO,"], [9.54, 11.28, "MA QUANDO È CECIL A PROVARE A UCCIDERVI"], [11.54, 13.86, "«È SENZA SPERANZA, TOTALMENTE SENZA SPERANZA.»"]]}, "S08E16|1198.0": {"d": 30, "caps": [[0.0, 1.78, "ECCO IL SUO UOMO, CAPO."], [2.22, 4.0, "CECIL? NON CREDO."], [4.38, 7.7, "SEMBRA OPERA DEL VECCHIO PAZZO TELESPALLA BOB."], [7.86, 9.18, "NO, CAPO. BOB È INNOCENTE."], [9.44, 10.29, "È LA VERITÀ."], [10.32, 11.34, "LA VERITÀ, EH?"], [11.4, 12.71, "SEMBRA LA TESTIMONIANZA"], [12.74, 15.06, "DELLA VECCHIA PAZZA LISA SIMPSON."], [15.28, 17.62, "CECIL HA APPENA CONFESSATO, CAPO."], [17.78, 18.78, "BEL LAVORO, LOU."], [19.16, 20.44, "PER QUESTO DIVENTERAI SERGENTE."], [20.58, 22.44, "EH, SONO GIÀ SERGENTE, CAPO."], [22.48, 24.31, "FORSE, MA IO DICO:"], [24.34, 25.92, "BOB TORNA IN PRIGIONE."], [26.02, 29.37, "MA... HO PRESO CECIL."], [29.4, 30, "PUÒ DARSI, MA LOU DICE"]]}, "S19E08|551.0": {"d": 19, "caps": [[0.0, -0.03, "QUESTA VOLTA NON HO COMMESSO ERRORI."], [0.0, 2.12, "IN REALTÀ, NE HAI FATTO UNO."], [2.5, 3.99, "CIÒ CHE SHAKESPEARE DISSE DAVVERO È:"], [4.02, 6.42, "«SAREBBE BENE FARLO PRESTO.»"], [6.58, 9.77, "SÌ, SONO SICURO CHE HAI STUDIATO A FONDO L'IMMORTALE BARDO"], [9.8, 12.3, "CON LA TUA MAESTRA HOOVER."], [13.58, 16.11, "MACBETH, ATTO PRIMO, SCENA SETTIMA."], [16.14, 17.06, "CONTROLLA."]]}, "S19E08|1184.0": {"d": 16.9, "caps": [[0.8, 4.06, "COME HAI ALLENTATO LE PIASTRELLE DEL MIO MOSAICO DI MORTE?"], [4.22, 6.39, "HO SOSPETTATO QUANDO HO VISTO CHE LA BARA"], [6.42, 9.26, "AVEVA SPAZIO EXTRA PER I TUOI PIEDI."], [9.5, 11.29, "PERCHÉ LA TUA FAMIGLIA AVREBBE PAGATO TANTO IN PIÙ"], [11.32, 13.08, "PER IL COMFORT DI UN MORTO?"], [14.12, 16.9, "MALEDETTE CANNONIERE GLORIOSE!"]]}, "S21E22|313.0": {"d": 18, "caps": [[0.66, 2.16, "EHI. SONO BART SIMPSON."], [2.42, 3.79, "SICURAMENTE AVRAI LETTO DI ME"], [3.82, 5.92, "NEL TUO AVVISO SUI VICINI MOLESTI."], [6.14, 7.06, "CIAO, BART."], [7.3, 8.48, "COSA? RIPETILO."], [8.76, 9.7, "CIAO, BART."], [10.08, 11.38, "CIAO, BART."], [11.5, 12.48, "CIAO, BART."], [12.54, 13.46, "CIAO, BART!"], [14.46, 15.94, "CIAO, BART."], [16.16, 17.36, "CIAO, BART."]]}, "S21E22|1160.0": {"d": 28, "caps": [[0.0, 2.04, "ASPETTA: PERCHÉ TANTA CONFIDENZA?"], [2.32, 5.67, "PERCHÉ TEMO CHE NON ABBIATE GIURISDIZIONE IN QUESTO STATO."], [5.7, 9.87, "BENVENUTO NELLA MIA GIURISDIZIONE."], [9.9, 13.41, "ALLORA, METTA PURE"], [13.44, 14.81, "LE MANI IN ALTO, SIGNORE."], [14.84, 24.81, "HA IL DIRITTO DI RIMANERE IN SILENZIO."], [24.84, 26.22, "LA PORTIAMO DENTRO."], [26.28, 27.74, "MA PRIMA FACCIAMO TAPPA AL MARE"], [27.77, 28, "PER UNO SKEE-BALL E DELLE FRITTELLE"]]}}